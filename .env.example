# Copy to .env (agent) or web/.env.local (web). Testnet only. Never commit real values.

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
PANDEM_ESCROW_ID=pandem-escrow-d1-8f199e48.testnet
PANDEM_TOKEN_ID=pandem-tusdc-46cee5ca.testnet
PANDEM_BUDGET_ID=pandem-budget-d1-8f199e48.testnet
PANDEM_REGISTRY_ID=pandem-registry-v2-46cee5ca.testnet
PANDEM_STEWARD_ID=pandem-steward-46cee5ca.testnet
PANDEM_TREASURY_ID=pandem-treasury-46cee5ca.testnet
PANDEM_AGENT_ID=pandem-agent-46cee5ca.testnet

# Agent (agent/ only). Function-call key on the agent account, limited to the escrow's heartbeat/release_period/claim_refund
AGENT_ACCOUNT_ID=pandem-agent.testnet
AGENT_FC_PRIVATE_KEY=
DEMO_PROVIDER_HEALTH_URL=http://localhost:3000/api/health
AGENT_PORT=8787

# NEAR AI Cloud (USD credits; demo uses the $10 NEAR Builders key)
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEAR_BUILDERS_API_KEY=
NEARAI_MODEL=Qwen/Qwen3.8-27B

# Mainnet edge on-ramp only (E-1/E-2); leave empty on testnet
ONECLICK_BASE_URL=https://1click.chaindefuser.com/v0
ONECLICK_API_KEY=

# Upstash Redis Configuration (submissions, onboarding, signups, deduplication)
UPSTASH_REDIS_REST_URL=https://desired-baboon-201841.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

